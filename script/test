#!/usr/bin/env bash
# Full test suite. Enforces 100% line coverage on the Splint target as a forcing function.
# Override with SPLINT_COVERAGE_THRESHOLD=<n> (0-100). See AGENTS.md "Testing".
set -euo pipefail
cd "$(dirname "$0")/.."

THRESHOLD="${SPLINT_COVERAGE_THRESHOLD:-100}"

# Self-test the marker parser and coverage math before running the suite.
# Fails fast if the gate tooling is broken without wasting a Swift build.
python3 script/lib/coverage.py --self-test

# Preflight: if another process is holding the SwiftPM workspace lock in
# .build/, `swift test` will block indefinitely waiting for it. Identify
# the holder(s), print copy-pasteable kill commands, and exit — better
# than hanging until the user ^Cs.
if [[ -e .build ]] && command -v lsof >/dev/null 2>&1; then
  holders="$(lsof -t -- .build/.lock .build/*.lock 2>/dev/null | sort -u || true)"
  if [[ -n "$holders" ]]; then
    echo "error: SwiftPM lock in .build/ is held by another process:" >&2
    while IFS= read -r pid; do
      [[ -n "$pid" ]] || continue
      ps -o pid=,command= -p "$pid" 2>/dev/null | sed 's/^ */  /' >&2
      echo "  kill: kill $pid" >&2
    done <<<"$holders"
    exit 2
  fi
fi

# Run instrumented tests. Not parallel: parallel + coverage historically
# produces per-worker profraws that need merging.
swift test --enable-code-coverage

# Locate the profdata and test binary. The bundle name and directory
# layout drift across toolchains (Swift ≤6.3: SplintPackageTests in
# .build/<triple>/debug; Swift 6.4: SplintTests.xctest under
# .build/out/Products/Debug), so match any .xctest executable.
PROFDATA="$(find .build -name default.profdata -path '*codecov*' | head -1)"
BINARY="$(find .build -path '*.xctest/Contents/MacOS/*' -type f -perm +111 | head -1)"
if [[ ! -x "$BINARY" ]]; then
  BINARY="$(find .build -name 'SplintPackageTests' -type f -perm +111 | head -1)"
fi
[[ -f "$PROFDATA" ]] || { echo "error: default.profdata not found" >&2; exit 2; }
[[ -x "$BINARY"  ]] || { echo "error: test binary not found under .build" >&2; exit 2; }

# Export per-line coverage in lcov format (DA:line,count is authoritative)
# and pipe through the coverage gate.
xcrun llvm-cov export -format=lcov -instr-profile="$PROFDATA" "$BINARY" \
  | python3 script/lib/coverage.py "$THRESHOLD"

# Example app: compile BookshelfApp (via .executableTarget) and run the
# swift-testing suite. No coverage gate — the 100% threshold scopes to
# Sources/Splint/ only (see AGENTS.md). The .xcodeproj is the runnable
# entry point for humans.
(cd Example && swift test)
